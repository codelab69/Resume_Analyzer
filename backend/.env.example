# Copy this file to `.env` and adjust. `.env` is git-ignored.
# Every value below has a working default in app/config.py, so an empty
# .env file is a valid configuration for local development.

# --- Server ---------------------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_MB=5
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# --- Storage --------------------------------------------------------------
# SQLite file, created automatically on first run.
DATABASE_PATH=storage/app.db

# There is no upload directory setting, on purpose. The uploaded file is read
# into memory, analysed and dropped - only the extracted text is stored, inside
# the report. The original PDF, with the candidate's name, phone number and
# email address in it, never touches the disk.

# --- Matching -------------------------------------------------------------
# Weights for the hybrid match score. Must sum to 1.0.
# Tune these against hand-labelled pairs, see scripts/tune_weights.py.
WEIGHT_SEMANTIC=0.40
WEIGHT_SKILL=0.30
WEIGHT_LEXICAL=0.20
WEIGHT_FIT=0.10

# --- Optional models ------------------------------------------------------
# Leave EMBEDDING_MODEL set even if sentence-transformers is not installed;
# the app detects the missing package and falls back automatically.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to "false" to force the deterministic fallback even when the package
# is available. Useful for reproducing results in the report.
USE_TRANSFORMER_EMBEDDINGS=true
